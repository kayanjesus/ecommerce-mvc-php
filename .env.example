############################################
# APLICAÇÃO
############################################
APP_NAME=ecommerce
APP_ENV=local
# Gere com: php artisan key:generate
APP_KEY=
# NUNCA deixe true em produção — vaza stack trace, paths e queries
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# URL pública usada pelo PagSeguro para enviar notificações de pagamento
# (webhooks). Em desenvolvimento local, use a URL gerada pelo Ngrok
# (ex: ngrok http 8000) — ela muda toda vez que você reinicia o Ngrok,
# então lembre de atualizar aqui e/ou no painel do PagSeguro sempre
# que reiniciar. Em produção, use a mesma URL do APP_URL.
WEBHOOK_URL=

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

############################################
# BANCO DE DADOS
############################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=root
DB_PASSWORD=

############################################
# INFRAESTRUTURA LARAVEL
############################################
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Em produção, prefira "database" ou "redis" em vez de "sync",
# para o envio de e-mail não travar a requisição HTTP do usuário.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

############################################
# E-MAIL (verificação de conta, notificações)
# Exemplo abaixo configurado para Brevo (smtp-relay.brevo.com).
# Pegue suas credenciais em: Brevo > perfil > SMTP & API > aba SMTP
############################################
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="naoresponda@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

############################################
# GOOGLE OAUTH (login social)
# Crie em https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/auth/google/callback
############################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

############################################
# PAGSEGURO
# - PAGSEGURO_BEARER_TOKEN: token da API V4 (Orders API) — o que o
#   projeto usa hoje para criar cobranças PIX e reembolsos.
#   Pegue em: Portal do Desenvolvedor PagBank > Sandbox > Tokens
# - PAGSEGURO_TOKEN: token da API V2 (legado). Mantido só por
#   compatibilidade; pode deixar vazio se não usar nada da V2.
# - PAGSEGURO_SANDBOX: true = ambiente de testes, false = produção real
# - PAGSEGURO_WEBHOOK_SECRET: chave configurada no painel do PagBank
#   para assinar as notificações de webhook. OBRIGATÓRIA em produção.
############################################
PAGSEGURO_EMAIL=
PAGSEGURO_TOKEN=
PAGSEGURO_BEARER_TOKEN=
PAGSEGURO_SANDBOX=true
PAGSEGURO_WEBHOOK_SECRET=

############################################
# VITE (variáveis expostas ao frontend)
############################################
VITE_APP_NAME="${APP_NAME}"

############################################
# PUSHER (broadcasting em tempo real) — OPCIONAL
# Só preencha se for usar notificações/eventos ao vivo no frontend.
# O pacote pusher-php-server já está no composer.json, mas hoje
# nenhuma dessas variáveis está configurada — sem elas, as VITE_PUSHER_*
# abaixo resolvem vazias e o broadcast não funciona.
############################################
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# PUSHER_APP_CLUSTER=sa1
# VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_HOST="${PUSHER_HOST}"
# VITE_PUSHER_PORT="${PUSHER_PORT}"
# VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
# VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
